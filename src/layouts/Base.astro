---
// Layout comune a tutte le pagine: intestazione HTML, caratteri, colori
// (chiaro e scuro), stili di base e avviso legale in fondo.
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const nomeSito = 'Guida Host BnB Italia';
const titoloCompleto = title === nomeSito ? title : `${title} · ${nomeSito}`;
// Indirizzo ufficiale della pagina: dice a Google quale copia contare (non workers.dev o www).
const canonico = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titoloCompleto}</title>
		<link rel="canonical" href={canonico} />
		{description && <meta name="description" content={description} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		<div class="wrap">
			<slot />
			<footer>
				<p class="legal">
					{nomeSito} è uno strumento indipendente, non affiliato ad Airbnb o Vrbo. Le commissioni
					cambiano spesso: il dato più affidabile resta la ricevuta della tua prenotazione. Questa pagina
					non è consulenza fiscale.
				</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg: #F1F4F3;
		--surface: #FFFFFF;
		--fg: #14211F;
		--muted: #55645F;
		--line: #D3DCD9;
		--accent: #0B5F7A;
		--accent-soft: #DDEEF3;
		--on-accent: #FFFFFF;
		--warn: #7A4F00;
		--warn-soft: #FAEFD3;
		--f-display: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
		--f-body: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--f-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) {
			--bg: #0E1517; --surface: #151F22; --fg: #E6EEEC; --muted: #9AAAA5; --line: #27373C;
			--accent: #62C4E2; --accent-soft: #123039; --on-accent: #06222B; --warn: #F0C36A; --warn-soft: #2C2310;
			color-scheme: dark;
		}
	}
	:root[data-theme="dark"] {
		--bg: #0E1517; --surface: #151F22; --fg: #E6EEEC; --muted: #9AAAA5; --line: #27373C;
		--accent: #62C4E2; --accent-soft: #123039; --on-accent: #06222B; --warn: #F0C36A; --warn-soft: #2C2310;
		color-scheme: dark;
	}

	* { box-sizing: border-box; }
	[hidden] { display: none !important; }
	body {
		background: var(--bg); color: var(--fg); font-family: var(--f-body); font-size: 16px; line-height: 1.5;
		padding-block: 28px 56px;
		padding-left: max(16px, env(safe-area-inset-left, 0px));
		padding-right: max(16px, env(safe-area-inset-right, 0px));
	}
	.wrap { max-width: 1080px; margin: 0 auto; display: flex; flex-direction: column; gap: 56px; }
	h1, h2, h3 { font-family: var(--f-display); margin: 0; text-wrap: balance; line-height: 1.1; }
	p { margin: 0; }
	a { color: var(--accent); text-underline-offset: 3px; }
	:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
	.eyebrow { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 600; }

	header { display: flex; flex-direction: column; gap: 14px; max-width: 46rem; }
	h1 { font-size: clamp(2.4rem, 7vw, 3.8rem); font-weight: 700; letter-spacing: -.02em; }
	.lead { font-size: 1.15rem; color: var(--muted); max-width: 40rem; }
	.stamp { align-self: flex-start; font-size: .82rem; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: var(--surface); }

	section { display: flex; flex-direction: column; gap: 20px; }
	.sec-head { display: flex; align-items: baseline; gap: 14px; }
	.step { font-family: var(--f-mono); font-size: .9rem; color: var(--on-accent); background: var(--accent); border-radius: 999px; width: 1.9rem; height: 1.9rem; display: inline-flex; align-items: center; justify-content: center; flex: none; transform: translateY(-2px); }
	h2 { font-size: 1.6rem; font-weight: 600; letter-spacing: -.01em; }
	.sec-note { color: var(--muted); max-width: 46rem; }

	.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 20px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
	.panel h3 { font-size: 1.25rem; font-weight: 600; }

	.notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
	.note { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
	.note h3 { font-size: 1.05rem; font-weight: 600; }
	.note p { font-size: .92rem; color: var(--muted); }
	.note.warn { background: var(--warn-soft); border-color: transparent; }
	.note.warn h3 { color: var(--warn); }
	.note.warn p { color: var(--fg); }
	.src { font-size: .88rem; color: var(--muted); display: flex; flex-direction: column; gap: 6px; padding-left: 18px; margin: 0; }
	.legal { font-size: .82rem; color: var(--muted); max-width: 44rem; }

	@media (max-width: 720px) {
		.wrap { gap: 44px; }
	}
</style>
